# Redis Connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Token Budget & Kill Switches
MAX_DAILY_TOKEN_BUDGET=1000000
MAX_REQUEST_TOKEN_LIMIT=8000
ENABLE_BUDGET_KILL_SWITCH=true

# Model Providers
PRIMARY_PROVIDER=openai
OPENAI_API_KEY=sk-...

SECONDARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

FALLBACK_PROVIDER=groq
GROQ_API_KEY=gsk_...
